LOGS_DIR=.dev/logs
TIMEZONE='Asia/Singapore'
TIMESTAMP_FORMAT=%y%m%d%H%M%S

# postgresql (as01 source db) - non-sensitive connection settings
# POSTGRES_PASSWORD lives in .secrets, never here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=as01_source_db
POSTGRES_USER=as01_admin
POSTGRES_CONTAINER_NAME=postgres-as01

# python venv
VENV_DIR=.venv
PYTHON_MIN_VERSION=3.11

# mock data seeding (feature 04) - row-count knobs, not secrets
MOCK_DATA_SEED=42
MOCK_DATA_DAYS=5
MOCK_DATA_TXN_PER_DAY=400
MOCK_DATA_FINANCE_TXN_PER_DAY=300
MOCK_DATA_PAYMENTS_PER_DAY=400
MOCK_DATA_CUSTOMERS=300

# spark cluster + jupyter (feature 03) - non-sensitive ports/resources
SPARK_MASTER_PORT=7077
SPARK_MASTER_UI_PORT=8080
SPARK_WORKER_COUNT=2
SPARK_WORKER_MEMORY=2G
SPARK_WORKER_CORES=2
JUPYTER_PORT=8888
JDBC_DRIVER_VERSION=42.7.3

PYSPARK_DIR=src/pyspark