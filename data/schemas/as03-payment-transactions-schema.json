{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_id": "as-03-payment-transactions-schema",
  "assignment": "Assessment 3 - Regulatory / Transaction Banking Data Quality, Lineage and Executive Dashboard",
  "layer": "source",
  "description": "Source payment extract feeding bronze.payment_transactions.",
  "tables": [
    {
      "table_name": "source.payment_transactions",
      "description": "Raw source payment extract.",
      "enforce_constraints": false,
      "enforce_constraints_notes": "Raw landing table - must accept missing customer_id, invalid beneficiary_country, and negative/zero amounts for Task 1 profiling to find. See docs/features/04-seed-mock-data.md.",
      "business_key": ["payment_id"],
      "columns": [
        { "name": "payment_id", "type": "string", "nullable": false, "description": "Unique payment identifier" },
        { "name": "customer_id", "type": "string", "nullable": false, "description": "Customer identifier" },
        { "name": "account_id", "type": "string", "nullable": false, "description": "Debited/credited account identifier" },
        { "name": "payment_date", "type": "date", "nullable": false, "description": "Business payment date" },
        { "name": "payment_timestamp", "type": "timestamp", "nullable": false, "description": "Payment processing timestamp" },
        { "name": "payment_type", "type": "string", "nullable": false, "description": "WIRE / GIRO / CARD / INTERNAL / INSTANT" },
        { "name": "payment_channel", "type": "string", "nullable": false, "description": "BRANCH / MOBILE / INTERNET / API" },
        { "name": "beneficiary_country", "type": "string", "length": 2, "nullable": false, "description": "Beneficiary country, ISO 3166-1 alpha-2" },
        { "name": "currency", "type": "string", "length": 3, "nullable": false, "description": "ISO currency" },
        { "name": "amount", "type": "decimal", "precision": 18, "scale": 2, "nullable": false, "description": "Payment amount" },
        { "name": "status", "type": "string", "nullable": false, "description": "COMPLETED / PENDING / FAILED / REJECTED" },
        { "name": "legal_entity", "type": "string", "nullable": false, "description": "Booking legal entity" }
      ]
    }
  ]
}
